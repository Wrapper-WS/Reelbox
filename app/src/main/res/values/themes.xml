<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Reelbox.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_play_mark</item>
        <item name="postSplashScreenTheme">@style/Theme.Reelbox</item>
    </style>

    <style name="Theme.Reelbox" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
